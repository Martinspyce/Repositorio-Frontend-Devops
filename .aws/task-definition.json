{
  "family": "Front-Task",
  "taskRoleArn": "arn:aws:iam::134162643101:role/LabRole",
  "executionRoleArn": "arn:aws:iam::134162643101:role/LabRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "Front-Task",
      "image": "134162643101.dkr.ecr.us-east-1.amazonaws.com/tienda-forntend",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "name": "front-task-80-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/Front-Task",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}
